{
  "name": "@glebmish/limn",
  "version": "0.4.0",
  "description": "Agentic local branch review — guided code review backed by Claude or Codex, served to your browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glebmish/limn.git"
  },
  "homepage": "https://github.com/glebmish/limn#readme",
  "bugs": {
    "url": "https://github.com/glebmish/limn/issues"
  },
  "bin": {
    "limn": "bin/limn.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "LIMN_DEV_HOOKS=1 vite",
    "dev:server": "LIMN_DEV_HOOKS=1 tsx watch src/cli/index.ts service serve",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.server.json",
    "serve": "npm run build && node bin/limn.js service serve",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pack:local": "scripts/pack-local.sh",
    "pack:smoke": "scripts/pack-smoke.sh",
    "prepack": "scripts/assert-no-platform-binaries.sh"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.55.0",
    "@agentclientprotocol/codex-acp": "1.1.0",
    "@agentclientprotocol/sdk": "1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "bundleDependencies": [
    "@agentclientprotocol/claude-agent-acp",
    "@agentclientprotocol/codex-acp",
    "@agentclientprotocol/sdk",
    "@modelcontextprotocol/sdk",
    "zod"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "highlight.js": "^11.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.8",
    "zustand": "^5.0.14"
  },
  "author": "glebmish"
}
